
<div class="layout flex flex--row flex--between">
  <div>
    <span class="value value--xlarge value--tnums">{{ current_pct }}%</span>
    <span class="label">Bank Rate</span>
  </div>
  <div>
    <span class="label label--small">Last change {{ last_change_date }}</span>
    <span class="value value--small value--tnums">{{ delta_pct }} pp</span>
    <span class="label label--small">Was {{ previous_pct }}%</span>
  </div>
</div>
<div class="title_bar">
  <span class="title">BoE Bank Rate</span>
</div>
